# Settings for the candidate website's API (and its ztforce worker).
#
# Copy to `.env` (git-ignored) and edit. The API loads it at startup; variables
# already set in the environment take precedence. Unset or commented-out
# settings use the defaults shown.

# ── credentials ───────────────────────────────────────────────────────────────
# IRSA login for ztforce's downloads. Required on a server; locally ztforce
# falls back to ~/.ztforce/config.toml if these are unset.
# ZTFORCE_IRSA_USER=
# ZTFORCE_IRSA_PASS=

# ── databases ─────────────────────────────────────────────────────────────────
# Where everything below lives, if you do not set them one by one. Point this
# at the external drive and the rest follow:
#   LT_DATA_DIR=/Volumes/YourDrive/db        (macOS)
#   LT_DATA_DIR=/mnt/ltdata/db               (Linux)
# The drive must be mounted before the API starts -- see RequiresMountsFor in
# deploy/lt-api.service. Local or USB disk only: SQLite's locking is not safe
# over SMB/NFS, and the annotations database is the irreplaceable one.
# LT_DATA_DIR=Data/db
#
# Relative paths are relative to where the API is started (the repo root).
# Read-only science database (rebuilt and republished from the laptop).
# LT_SCIENCE_DB=Data/db/science.sqlite
# Labels and notes: the master copy, back it up.
# LT_ANNOTATIONS_DB=Data/db/annotations.sqlite
# ztforce queue and results: regenerable, but keep it on persistent disk.
# LT_ZTFORCE_DB=Data/db/ztforce.sqlite
# Catalog behind the candidate list's filters.
# LT_CATALOG_PARQUET=Data/db/sources.parquet

# ── ztforce queue ─────────────────────────────────────────────────────────────
# Annotation label that queues a source for ztforce.
# LT_ZTFORCE_LABEL=Run ztforce
# Sources photometered at once; each runs 8 parallel IRSA downloads.
LT_ZTFORCE_CONCURRENCY=4
# Run the queue worker inside the API process (1), or turn it off (0).
# Run only one API process per ztforce database.
# LT_ZTFORCE_WORKER=1

# ── cutouts ───────────────────────────────────────────────────────────────────
# LT_CUTOUT_CACHE=Data/db/cutout_cache
# Cache size budget in GB; 0 disables the sweep.
# LT_CUTOUT_MAX_GB=20

# ── catalog filter engine ─────────────────────────────────────────────────────
# LT_FILTER_THREADS=4
# LT_FILTER_MEMORY_LIMIT=2GB

# ── web ───────────────────────────────────────────────────────────────────────
# The compiled site. When this folder exists the API serves the pages as well
# as the data, so the whole website is one process on one port -- run
# `npm run build` in web/ to create it. Unset in development, where Vite
# serves the pages and proxies /api here.
# LT_WEB_DIST=web/dist
#
# Origins allowed to call the API (comma-separated). Only needed when the page
# is served from somewhere other than the API; with LT_WEB_DIST above the two
# share an origin and this does nothing.
# LT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#
# The frontend itself reads VITE_API_BASE from web/.env (Vite's own mechanism);
# leave it unset when the API is served from the same origin under /api.
